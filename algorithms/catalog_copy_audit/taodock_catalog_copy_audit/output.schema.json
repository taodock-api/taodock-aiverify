{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["total", "passed", "flagged", "findings"],
  "properties": {
    "total": {"type": "integer", "minimum": 1, "maximum": 500},
    "passed": {"type": "integer", "minimum": 0, "maximum": 500},
    "flagged": {"type": "integer", "minimum": 0, "maximum": 500},
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "issues"],
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 80},
          "issues": {
            "type": "array",
            "minItems": 1,
            "maxItems": 141,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": {
                  "enum": ["empty_draft", "missing_measurement", "unlisted_measurement", "missing_phrase"]
                },
                "value": {"type": "string", "maxLength": 100}
              }
            }
          }
        }
      }
    }
  }
}
